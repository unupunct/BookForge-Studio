{
  "key": "literary_fiction",
  "name": "Novel – Literary Fiction",
  "description": "Quiet Palatino pages, Roman chapter numbers, generous drop.",
  "builtin": true,
  "version": 1,
  "settings": {
    "page_size": "US Trade 6x9",
    "width_mm": 152.4,
    "height_mm": 228.6,
    "margins": {
      "top": 23,
      "bottom": 27,
      "inner": 26,
      "outer": 19
